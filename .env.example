# Copy to .env (never commit .env) and fill in your own values.

# Required for the chat. Free key from https://console.groq.com/keys
# (Without it, chord names typed in the chat and the piano still work.)
GROQ_API_KEY=

# Optional: enables "Chords of <song>" via web search. Free key from https://app.tavily.com
TAVILY_API_KEY=

# Optional overrides (defaults shown)
# The model is chosen automatically from what your Groq account offers
# (preferences in chordsai/models.py). Set this only to force a model.
# GROQ_MODEL=openai/gpt-oss-120b
# MESSAGES_PER_SESSION_PER_HOUR=30
# MESSAGES_PER_DAY=300
# MAX_MESSAGE_LENGTH=300
